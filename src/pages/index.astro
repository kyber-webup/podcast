---
import { getCollection } from "astro:content";
import "../styles/global.css";
import Player from "../components/Player.astro";
import EpisodeList from "../components/EpisodeList.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { buildRoster } from "../lib/team";
import type { PlayerEpisode } from "../lib/playback";

const episodes = (await getCollection("episodes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const current = episodes[0];

// Maquette : l'écran affiche toute l'équipe, seuls les animateurs de l'épisode
// en cours sont allumés (voir src/lib/team.ts).
const roster = buildRoster(episodes.flatMap((episode) => episode.data.hosts));

// En dev, PUBLIC_AUDIO_BASE peut pointer vers public/dev-audio/ (voir README).
// En production, la route /audio/<fichier> est servie par le Worker.
const audioBase = import.meta.env.PUBLIC_AUDIO_BASE ?? "/audio";

// §5.3 : les métadonnées de tous les épisodes sont sérialisées ici, lues par le
// contrôleur au démarrage — pas de requête réseau supplémentaire pour ces données.
const playerEpisodes: PlayerEpisode[] = episodes.map((episode) => ({
  id: episode.id,
  title: episode.data.title,
  hosts: episode.data.hosts,
  date: episode.data.date.toISOString(),
  duration: episode.data.duration,
  audioSrc: `${audioBase}/${episode.data.file}`,
  chapters: episode.data.chapters,
}));
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffeee5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101828" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <title>{current.data.title} — DevNote</title>
  </head>
  <body class="min-h-screen bg-page font-mono text-ink">
    <a
      href="#episode-list"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-active focus:px-4 focus:py-2 focus:text-page"
    >
      Aller à la liste des épisodes
    </a>

    <header class="relative flex h-10 items-center justify-center border-b border-header-edge bg-header">
      <h1 class="text-sm font-bold text-header-ink">DevNote player</h1>
      <ThemeToggle />
    </header>

    <main>
      <div class="mx-auto w-full max-w-xl px-5 pt-10.5 pb-8">
        {/* NF-41 : sans JavaScript, la liste des épisodes reste lisible, mais le lecteur ne fonctionne pas. */}
        <noscript>
          <p
            class="mb-6 rounded-xs border border-screen-edge bg-screen-ink/15 px-3 py-2 text-xs text-ink"
          >
            Le lecteur a besoin de JavaScript pour fonctionner. La liste des épisodes reste consultable ci-dessous.
          </p>
        </noscript>

        <Player episode={playerEpisodes[0]} roster={roster} />

        <EpisodeList episodes={episodes} currentId={current.id} />
      </div>
    </main>

    <script type="application/json" id="episodes-data" is:inline set:html={JSON.stringify(playerEpisodes)}></script>
  </body>
</html>

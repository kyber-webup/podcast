---
import { getCollection } from "astro:content";
import "../styles/global.css";
import Player from "../components/Player.astro";
import ChapterList from "../components/ChapterList.astro";
import EpisodeList from "../components/EpisodeList.astro";
import { getCurrentChapterIndex } from "../lib/chapters";

const episodes = (await getCollection("episodes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const current = episodes[0];

// En dev, PUBLIC_AUDIO_BASE peut pointer vers public/dev-audio/ (voir README).
// En production, la route /audio/<fichier> est servie par le Worker (étape 9).
const audioBase = import.meta.env.PUBLIC_AUDIO_BASE ?? "/audio";

// État initial avant JS : aucune lecture n'a eu lieu (F-20), le contrôleur applique
// la position sauvegardée dès son démarrage (voir src/scripts/player.ts, étape 5).
const currentChapterIndex = getCurrentChapterIndex(current.data.chapters, 0);

// §5.3 : les métadonnées de tous les épisodes sont sérialisées ici, lues par le
// contrôleur au démarrage — pas de requête réseau supplémentaire pour ces données.
const episodesData = episodes.map((episode) => ({
  id: episode.id,
  title: episode.data.title,
  hosts: episode.data.hosts,
  date: episode.data.date.toISOString(),
  duration: episode.data.duration,
  audioSrc: `${audioBase}/${episode.data.file}`,
  chapters: episode.data.chapters,
}));
---

<html lang="fr" class="scheme-dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#101828" /><!-- gray-900 -->
		<meta name="generator" content={Astro.generator} />
		<title>{current.data.title} — DevNote</title>
	</head>
	<body class="min-h-screen bg-gray-800 font-mono text-white">
		<a
			href="#episode-list"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-cyan-400 focus:px-4 focus:py-2 focus:text-gray-900"
		>Aller à la liste des épisodes</a>

		<header
			class="flex h-10 items-center justify-center border-b border-cyan-100/50 bg-gray-900"
		>
			<h1 class="text-sm font-bold text-rose-400">DevNote player</h1>
		</header>

		<main>
			<div class="mx-auto w-full max-w-sm px-5 pt-11">
				<Player
					title={current.data.title}
					hosts={current.data.hosts}
					duration={current.data.duration}
					chapters={current.data.chapters}
					currentChapterIndex={currentChapterIndex}
					audioSrc={`${audioBase}/${current.data.file}`}
				/>

				<ChapterList chapters={current.data.chapters} currentIndex={currentChapterIndex} />
			</div>

			<hr class="mt-15 border-rose-500" />

			<div class="mx-auto w-full max-w-sm px-5 pt-15 pb-8">
				<EpisodeList episodes={episodes} currentId={current.id} />
			</div>
		</main>

		<script type="application/json" id="episodes-data" is:inline set:html={JSON.stringify(episodesData)} />

		<footer class="mx-auto w-full max-w-sm px-5 pb-6 text-xs text-gray-400">
			<p>DevNote — podcast interne de l'agence.</p>
		</footer>
	</body>
</html>

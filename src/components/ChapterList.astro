---
import { formatTime, toSpokenTime } from "../lib/time";
import type { Chapter } from "../lib/chapters";

interface Props {
  chapters: Chapter[];
  currentIndex: number;
}

const { chapters, currentIndex } = Astro.props;
---

<nav aria-label="Chapitres" id="chapters" hidden={chapters.length === 0}>
  <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Chapitres</h2>
  <ol id="chapter-list-items" class="mt-3 flex flex-col gap-1">
    {chapters.map((chapter, index) => (
      <li>
        <button
          type="button"
          data-chapter-index={index}
          class="flex w-full min-h-11 items-center gap-3 rounded-control px-3 py-2 text-left text-slate-700 aria-[current=true]:bg-accent aria-[current=true]:font-semibold aria-[current=true]:text-accent-contrast hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-current={index === currentIndex ? "true" : undefined}
          aria-label={`Aller au chapitre ${index + 1} : ${chapter.title}, à ${toSpokenTime(chapter.start)}`}
        >
          <span aria-hidden="true" class="tabular-nums text-sm opacity-80">
            {formatTime(chapter.start)}
          </span>
          <span>{chapter.title}</span>
        </button>
      </li>
    ))}
  </ol>
</nav>

---
import type { CollectionEntry } from "astro:content";

interface Props {
  episodes: CollectionEntry<"episodes">[];
  currentId: string;
}

const { episodes, currentId } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});

// La maquette affiche un code « S01E02 ». Le numéro d'épisode vient du préfixe
// NNN du nom de fiche (convention de nommage du README) ; la saison est fixe
// tant que le modèle de données n'a pas de champ dédié.
const SEASON = 1;

function episodeCode(id: string): string | undefined {
  const match = /^(\d+)/.exec(id);
  if (!match) {
    return undefined;
  }
  const season = String(SEASON).padStart(2, "0");
  const number = String(Number(match[1])).padStart(2, "0");
  return `S${season}E${number}`;
}
---

<section aria-labelledby="episodes-heading" id="episode-list">
  <h2 id="episodes-heading" class="text-base font-bold text-cyan-400">Épisodes</h2>

  <ol class="mt-2 flex flex-col gap-2.5">
    {
      episodes.map((episode) => {
        const isCurrent = episode.id === currentId;
        const code = episodeCode(episode.id);

        return (
          <li
            data-episode-id={episode.id}
            aria-current={isCurrent ? "true" : undefined}
            class="rounded-xs border border-cyan-400 bg-gray-800 p-3.5 inset-shadow-sm aria-[current=true]:border-2 aria-[current=true]:bg-cyan-500/15"
          >
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <p
                  class="episode-current-marker flex items-center gap-2 text-xs font-bold text-rose-400"
                  hidden={!isCurrent}
                >
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 8 16"
                    class="h-4 w-auto shrink-0"
                    fill="none"
                  >
                    <path
                      d="M7.2 7.57895V6.73684H6.4V5.89474H5.6V5.05263H4.8V4.21053H4V3.36842H3.2V2.52632H2.4V1.68421H1.6V0.842105H0.8V0H0V0.842105V1.68421V2.52632V3.36842V4.21053V5.05263V5.89474V6.73684V7.57895V8.42105V9.26316V10.1053V10.9474V11.7895V12.6316V13.4737V14.3158V15.1579V16H0.8V15.1579H1.6V14.3158H2.4V13.4737H3.2V12.6316H4V11.7895H4.8V10.9474H5.6V10.1053H6.4V9.26316H7.2V8.42105H8V7.57895H7.2Z"
                      fill="currentColor"
                    />
                  </svg>
                  En cours de lecture
                </p>
                {/* Rempli par le contrôleur au démarrage, à partir de localStorage (F-60, F-65). */}
                <div class="episode-badge-slot" data-episode-badge-slot />
              </div>

              <button
                type="button"
                data-episode-id={episode.id}
                hidden
                class="episode-toggle-completed shrink-0 text-xs text-gray-400 underline-offset-2 hover:text-white hover:underline"
              >
                Marquer comme écouté
              </button>
            </div>

            <button
              type="button"
              data-episode-id={episode.id}
              class="episode-play-button mt-4 block w-full text-left"
            >
              <span class="flex gap-2.5 text-xs text-white">
                {code && <span>{code}</span>}
                <span>{dateFormatter.format(episode.data.date)}</span>
              </span>
              <span class="block text-sm font-bold text-white">{episode.data.title}</span>
              {episode.data.description && (
                <span class="mt-4 block text-xs/4.5 text-white">
                  {episode.data.description}
                </span>
              )}
            </button>
          </li>
        );
      })
    }
  </ol>
</section>

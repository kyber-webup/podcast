---
import { formatTime, toSpokenTime } from "../lib/time";
import { formatChapterLabel, getCurrentChapterIndex } from "../lib/chapters";
import type { PlayerEpisode } from "../lib/playback";
import PlayerScreen from "./PlayerScreen.astro";
import SkipIcon from "./SkipIcon.astro";
import TransportButton from "./TransportButton.astro";

interface Props {
  episode: PlayerEpisode;
  roster: string[];
}

const { episode, roster } = Astro.props;
const { title, hosts, duration, chapters, audioSrc } = episode;

// État initial avant JS : aucune lecture n'a eu lieu (F-20), le contrôleur applique
// la position sauvegardée dès son démarrage (voir src/scripts/player.ts).
const currentChapterIndex = getCurrentChapterIndex(chapters, 0);
const currentChapter = currentChapterIndex >= 0 ? chapters[currentChapterIndex] : undefined;
const hasPrevChapter = currentChapterIndex > 0;
const hasNextChapter = chapters.length > 0 && currentChapterIndex < chapters.length - 1;

const startTime = formatTime(0, { pad: true });
---

<section aria-label="Lecteur">
  <audio id="player-audio" preload="metadata" src={audioSrc}></audio>

  <PlayerScreen title={title} hosts={hosts} roster={roster} />

  <p
    id="playback-error"
    role="alert"
    hidden
    class="mt-4 flex items-center justify-between gap-3 rounded-xs border border-screen-edge bg-screen-ink/15 px-3 py-2 text-xs text-ink"
  >
    La lecture a échoué.
    <button
      type="button"
      id="retry-button"
      class="shrink-0 rounded-xs border border-screen-edge px-2.5 py-1 font-bold hover:bg-screen-ink/25"
    >
      Réessayer
    </button>
  </p>

  <p id="chapter-title" hidden={!currentChapter} class="mt-10.5 truncate text-xs text-muted">
    {currentChapter ? formatChapterLabel(currentChapterIndex, currentChapter.title) : ""}
  </p>

  <p class="mt-1 text-xs font-bold text-ink">
    <span id="elapsed-time">{startTime}</span> / <span id="total-duration">{formatTime(duration, { pad: true })}</span>
  </p>

  <label for="seek-bar" class="sr-only">
    Position de lecture
  </label>
  <input
    type="range"
    id="seek-bar"
    min="0"
    max={duration}
    step="1"
    value="0"
    class:list={[
      "mt-3 block h-6 w-full cursor-pointer appearance-none bg-transparent",
      "range-track:h-1.5 range-track:rounded-xs range-track:border range-track:border-control-edge range-track:bg-track",
      // Portion écoutée, peinte via --seek-progress (mis à jour par player.ts).
      "range-track:bg-linear-to-r range-track:from-active range-track:to-active range-track:bg-size-[var(--seek-progress,0%)_100%] range-track:bg-no-repeat",
      "range-thumb:h-6 range-thumb:w-3.5 range-thumb:appearance-none range-thumb:rounded-xs range-thumb:border range-thumb:border-control-edge range-thumb:bg-thumb",
      "range-thumb:shadow-sm range-thumb:transition-shadow range-thumb:duration-300 range-thumb:ease-in-out",
      // Halos réservés au thème sombre : discret au repos, plein au survol, au contact et au focus clavier.
      "dark:range-thumb:shadow-glow-subtle dark:range-thumb:inset-shadow-glow-subtle",
      "dark:range-thumb:hover:shadow-glow dark:range-thumb:hover:inset-shadow-glow",
      "dark:range-thumb:active:shadow-glow dark:range-thumb:active:inset-shadow-glow",
      "dark:range-thumb:focus-visible:shadow-glow dark:range-thumb:focus-visible:inset-shadow-glow",
      // WebKit aligne le pouce sur le haut de la piste : on le remonte de la moitié
      // de leur différence de hauteur, bordures comprises — (6 + 2 − 24 − 2) / 2.
      "[&::-webkit-slider-thumb]:-mt-2.25",
    ]}
    aria-valuetext={`${toSpokenTime(0)} sur ${toSpokenTime(duration)}`}
  />

  <div class="mt-8.5 flex h-12 rounded-sm border border-control-edge bg-control">
    <TransportButton
      id="previous-chapter-button"
      disabled={!hasPrevChapter}
      aria-label="Chapitre précédent"
      class="border-r border-control-edge"
    >
      <SkipIcon direction="backward" withBar />
    </TransportButton>

    <TransportButton id="skip-back-button" aria-label="Reculer de 15 secondes" class="border-r border-control-edge">
      <SkipIcon direction="backward" />
    </TransportButton>

    <TransportButton
      id="play-pause-button"
      data-state="idle"
      class="not-data-[state=idle]:bg-active-bg not-data-[state=idle]:text-control-ink-strong not-data-[state=idle]:inset-shadow-pressed dark:border-2 dark:border-transparent dark:not-data-[state=idle]:border-active dark:not-data-[state=idle]:inset-shadow-none dark:data-[state=playing]:inset-shadow-glow dark:data-[state=paused]:animate-glow-pulse"
    >
      <span id="play-icon" class="flex">
        <svg aria-hidden="true" viewBox="0 0 8 16" class="h-5 w-auto" fill="none">
          <path
            d="M7.2 7.57895V6.73684H6.4V5.89474H5.6V5.05263H4.8V4.21053H4V3.36842H3.2V2.52632H2.4V1.68421H1.6V0.842105H0.8V0H0V0.842105V1.68421V2.52632V3.36842V4.21053V5.05263V5.89474V6.73684V7.57895V8.42105V9.26316V10.1053V10.9474V11.7895V12.6316V13.4737V14.3158V15.1579V16H0.8V15.1579H1.6V14.3158H2.4V13.4737H3.2V12.6316H4V11.7895H4.8V10.9474H5.6V10.1053H6.4V9.26316H7.2V8.42105H8V7.57895H7.2Z"
            fill="currentColor"
          ></path>
        </svg>
      </span>
      <span id="pause-icon" hidden class="flex">
        <svg aria-hidden="true" viewBox="0 0 12 20" class="h-5 w-auto" fill="none">
          <path d="M7.63636 0V20H12V0H7.63636Z" fill="currentColor"></path>
          <path d="M0 0V20H4.36364V0H0Z" fill="currentColor"></path>
        </svg>
      </span>
      <span id="play-pause-label" class="sr-only">
        Lecture
      </span>
    </TransportButton>

    <TransportButton id="skip-forward-button" aria-label="Avancer de 15 secondes" class="border-l border-control-edge">
      <SkipIcon direction="forward" />
    </TransportButton>

    <TransportButton
      id="next-chapter-button"
      disabled={!hasNextChapter}
      aria-label="Chapitre suivant"
      class="border-l border-control-edge"
    >
      <SkipIcon direction="forward" withBar />
    </TransportButton>
  </div>
</section>

<script>
  import "../scripts/player";
</script>

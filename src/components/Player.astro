---
import { formatTime, toSpokenTime } from "../lib/time";
import type { Chapter } from "../lib/chapters";
import { seekClass } from "../lib/classes";

interface Props {
  title: string;
  hosts: string[];
  duration: number;
  chapters: Chapter[];
  currentChapterIndex: number;
  audioSrc: string;
}

const { title, hosts, duration, chapters, currentChapterIndex, audioSrc } = Astro.props;
const currentChapter = currentChapterIndex >= 0 ? chapters[currentChapterIndex] : undefined;
const hasPrevChapter = currentChapterIndex > 0;
const hasNextChapter = chapters.length > 0 && currentChapterIndex < chapters.length - 1;

const transportButtonClass =
  "flex flex-1 items-center justify-center text-gray-400 transition-colors hover:text-white hover:cursor-pointer disabled:pointer-events-none disabled:opacity-35";
---

<section aria-label="Lecteur">
  <audio id="audio" preload="metadata" src={audioSrc}></audio>

  <div class="flex items-start gap-3">
    {/* Écran LCD : temps écoulé + vu-mètre */}
    <div
      class="flex h-18 w-38 shrink-0 flex-col justify-between rounded-xs border border-rose-500 bg-gray-900"
    >
      <div class="flex items-center justify-between gap-2 px-2.5 pt-2.5">
        {/* Trois états pilotés par player.ts : arrêt (rien lancé), lecture, pause. */}
        <span class="flex size-4 shrink-0 items-center justify-center text-rose-400">
          <span id="screen-stop" class="flex">
            <svg aria-hidden="true" viewBox="0 0 12 12" class="size-3" fill="none">
              <rect width="12" height="12" fill="currentColor"></rect>
            </svg>
          </span>
          <span id="screen-play" hidden class="flex">
            <svg aria-hidden="true" viewBox="0 0 16 14" class="h-3.5 w-auto rotate-90" fill="none">
              <path d="M8 0L16 14H0L8 0Z" fill="currentColor"></path>
            </svg>
          </span>
          <span id="screen-pause" hidden class="flex">
            <svg aria-hidden="true" viewBox="0 0 12 20" class="h-3.5 w-auto" fill="none">
              <path d="M7.63636 0V20H12V0H7.63636Z" fill="currentColor"></path>
              <path d="M0 0V20H4.36364V0H0Z" fill="currentColor"></path>
            </svg>
          </span>
        </span>
        <span id="time-big" class="font-counter text-[22px] leading-none font-light text-rose-400">{formatTime(0, { pad: true })}</span>
      </div>

      {/* Vu-mètre : barres collées au bas de l'écran, animées pendant la lecture
      par src/scripts/visualizer.ts. Au repos (y2 = y1) elles sont de hauteur nulle,
      donc invisibles. Couleur via currentColor, halo via drop-shadow-glow. */}
      <svg
        id="waveform"
        aria-hidden="true"
        viewBox="0 0 132 26"
        preserveAspectRatio="none"
        class="block h-6.5 w-full px-2.5 text-rose-400 drop-shadow-glow"
        fill="none"
      >
        <line x1="4.5" y1="26" x2="4.5" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="14.75" y1="26" x2="14.75" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="25" y1="26" x2="25" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="35.25" y1="26" x2="35.25" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="45.5" y1="26" x2="45.5" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="55.75" y1="26" x2="55.75" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="66" y1="26" x2="66" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="76.25" y1="26" x2="76.25" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="86.5" y1="26" x2="86.5" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="96.75" y1="26" x2="96.75" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="107" y1="26" x2="107" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="117.25" y1="26" x2="117.25" y2="26" stroke="currentColor" stroke-width="3"></line>
        <line x1="127.5" y1="26" x2="127.5" y2="26" stroke="currentColor" stroke-width="3"></line>
      </svg>
    </div>

    {/* Animateurs + titre de l'épisode en cours */}
    <div class="min-w-0 -mt-1">
      <p id="player-hosts" class="text-xs text-cyan-400 uppercase" hidden={hosts.length === 0}>
        {hosts.join(", ")}
      </p>
      <p id="player-episode-title" class="mt-2 text-sm font-bold text-cyan-400">
        {title}
      </p>
    </div>
  </div>

  <p
    id="player-error"
    role="alert"
    hidden
    class="mt-4 flex items-center justify-between gap-3 rounded-xs border border-rose-500 bg-rose-500/20 px-3 py-2 text-xs text-rose-400"
  >
    La lecture a échoué.
    <button
      type="button"
      id="btn-retry"
      class="shrink-0 rounded-xs border border-rose-500 px-2.5 py-1 font-bold hover:bg-rose-500/30"
    >
      Réessayer
    </button>
  </p>

  <p
        id="player-chapter-title"
        hidden={!currentChapter}
        class="mt-10 text-xs text-gray-400"
      >
        {currentChapter?.title}
      </p>
  <p class="text-xs mt-2 text-white">
    <span id="time-current">{formatTime(0, { pad: true })}</span> / <span id="time-duration">{formatTime(duration, { pad: true })}</span>
  </p>

  <label for="seek" class="sr-only">Position de lecture</label>
  <input
    type="range"
    id="seek"
    min="0"
    max={duration}
    step="1"
    value="0"
    class={`mt-2 ${seekClass}`}
    aria-valuetext={`${toSpokenTime(0)} sur ${toSpokenTime(duration)}`}
  />

  {/* Transport : chapitre précédent, −15 s, lecture/pause, +15 s, chapitre suivant */}
  <div class="mt-9 flex h-12 rounded-sm border border-gray-700 bg-gray-800">
    <button
      type="button"
      id="btn-prev-chapter"
      disabled={!hasPrevChapter}
      aria-label="Chapitre précédent"
      class={`${transportButtonClass} border-r border-gray-700`}
    >
      <svg aria-hidden="true" viewBox="0 0 25 20" class="h-5 w-auto -scale-x-100" fill="none">
        <path
          d="M9.45 9.47368V8.42105H8.4V7.36842H7.35V6.31579H6.3V5.26316H5.25V4.21053H4.2V3.15789H3.15V2.10526H2.1V1.05263H1.05V0H0V20H1.05V18.9474H2.1V17.8947H3.15V16.8421H4.2V15.7895H5.25V14.7368H6.3V13.6842H7.35V12.6316H8.4V11.5789H9.45V10.5263H10.5V9.47368H9.45Z"
          fill="currentColor"></path>
        <path
          d="M19.95 9.47368V8.42105H18.9V7.36842H17.85V6.31579H16.8V5.26316H15.75V4.21053H14.7V3.15789H13.65V2.10526H12.6V1.05263H11.55V0H10.5V9.47368V10.5263V20H11.55V18.9474H12.6V17.8947H13.65V16.8421H14.7V15.7895H15.75V14.7368H16.8V13.6842H17.85V12.6316H18.9V11.5789H19.95V10.5263H21V9.47368H19.95Z"
          fill="currentColor"></path>
        <path d="M21 0H25V20H21V0Z" fill="currentColor"></path>
      </svg>
    </button>

    <button
      type="button"
      id="btn-back-15"
      aria-label="Reculer de 15 secondes"
      class={`${transportButtonClass} border-r border-gray-700`}
    >
      <svg aria-hidden="true" viewBox="0 0 21 20" class="h-5 w-auto -scale-x-100" fill="none">
        <path
          d="M9.45 9.47368V8.42105H8.4V7.36842H7.35V6.31579H6.3V5.26316H5.25V4.21053H4.2V3.15789H3.15V2.10526H2.1V1.05263H1.05V0H0V20H1.05V18.9474H2.1V17.8947H3.15V16.8421H4.2V15.7895H5.25V14.7368H6.3V13.6842H7.35V12.6316H8.4V11.5789H9.45V10.5263H10.5V9.47368H9.45Z"
          fill="currentColor"></path>
        <path
          d="M19.95 9.47368V8.42105H18.9V7.36842H17.85V6.31579H16.8V5.26316H15.75V4.21053H14.7V3.15789H13.65V2.10526H12.6V1.05263H11.55V0H10.5V9.47368V10.5263V20H11.55V18.9474H12.6V17.8947H13.65V16.8421H14.7V15.7895H15.75V14.7368H16.8V13.6842H17.85V12.6316H18.9V11.5789H19.95V10.5263H21V9.47368H19.95Z"
          fill="currentColor"></path>
      </svg>
    </button>

    <button
      type="button"
      id="btn-play-pause"
      data-state="idle"
      class={`${transportButtonClass} border-2 border-transparent not-data-[state=idle]:border-cyan-400 not-data-[state=idle]:text-white data-[state=playing]:inset-shadow-glow data-[state=paused]:animate-glow-pulse`}
    >
      <span id="icon-play" class="flex">
        <svg aria-hidden="true" viewBox="0 0 8 16" class="h-5 w-auto" fill="none">
          <path
            d="M7.2 7.57895V6.73684H6.4V5.89474H5.6V5.05263H4.8V4.21053H4V3.36842H3.2V2.52632H2.4V1.68421H1.6V0.842105H0.8V0H0V0.842105V1.68421V2.52632V3.36842V4.21053V5.05263V5.89474V6.73684V7.57895V8.42105V9.26316V10.1053V10.9474V11.7895V12.6316V13.4737V14.3158V15.1579V16H0.8V15.1579H1.6V14.3158H2.4V13.4737H3.2V12.6316H4V11.7895H4.8V10.9474H5.6V10.1053H6.4V9.26316H7.2V8.42105H8V7.57895H7.2Z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span id="icon-pause" hidden class="flex">
        <svg aria-hidden="true" viewBox="0 0 12 20" class="h-5 w-auto" fill="none">
          <path d="M7.63636 0V20H12V0H7.63636Z" fill="currentColor"></path>
          <path d="M0 0V20H4.36364V0H0Z" fill="currentColor"></path>
        </svg>
      </span>
      <span id="btn-play-pause-label" class="sr-only">Lecture</span>
    </button>

    <button
      type="button"
      id="btn-forward-15"
      aria-label="Avancer de 15 secondes"
      class={`${transportButtonClass} border-l border-gray-700`}
    >
      <svg aria-hidden="true" viewBox="0 0 21 20" class="h-5 w-auto" fill="none">
        <path
          d="M9.45 9.47368V8.42105H8.4V7.36842H7.35V6.31579H6.3V5.26316H5.25V4.21053H4.2V3.15789H3.15V2.10526H2.1V1.05263H1.05V0H0V20H1.05V18.9474H2.1V17.8947H3.15V16.8421H4.2V15.7895H5.25V14.7368H6.3V13.6842H7.35V12.6316H8.4V11.5789H9.45V10.5263H10.5V9.47368H9.45Z"
          fill="currentColor"></path>
        <path
          d="M19.95 9.47368V8.42105H18.9V7.36842H17.85V6.31579H16.8V5.26316H15.75V4.21053H14.7V3.15789H13.65V2.10526H12.6V1.05263H11.55V0H10.5V9.47368V10.5263V20H11.55V18.9474H12.6V17.8947H13.65V16.8421H14.7V15.7895H15.75V14.7368H16.8V13.6842H17.85V12.6316H18.9V11.5789H19.95V10.5263H21V9.47368H19.95Z"
          fill="currentColor"></path>
      </svg>
    </button>

    <button
      type="button"
      id="btn-next-chapter"
      disabled={!hasNextChapter}
      aria-label="Chapitre suivant"
      class={`${transportButtonClass} border-l border-gray-700`}
    >
      <svg aria-hidden="true" viewBox="0 0 25 20" class="h-5 w-auto" fill="none">
        <path
          d="M9.45 9.47368V8.42105H8.4V7.36842H7.35V6.31579H6.3V5.26316H5.25V4.21053H4.2V3.15789H3.15V2.10526H2.1V1.05263H1.05V0H0V20H1.05V18.9474H2.1V17.8947H3.15V16.8421H4.2V15.7895H5.25V14.7368H6.3V13.6842H7.35V12.6316H8.4V11.5789H9.45V10.5263H10.5V9.47368H9.45Z"
          fill="currentColor"></path>
        <path
          d="M19.95 9.47368V8.42105H18.9V7.36842H17.85V6.31579H16.8V5.26316H15.75V4.21053H14.7V3.15789H13.65V2.10526H12.6V1.05263H11.55V0H10.5V9.47368V10.5263V20H11.55V18.9474H12.6V17.8947H13.65V16.8421H14.7V15.7895H15.75V14.7368H16.8V13.6842H17.85V12.6316H18.9V11.5789H19.95V10.5263H21V9.47368H19.95Z"
          fill="currentColor"></path>
        <path d="M21 0H25V20H21V0Z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  import "../scripts/player";
</script>

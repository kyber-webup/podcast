{
  "name": "podcast-player",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postbuild": "rm -rf dist/dev-audio"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "jose": "^6.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
